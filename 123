local DK_HOP_THRESHOLD_SEC = 1800
local dkHopGeneration = 0

local function findBossConfigByKey(key)
    for _, cfg in ipairs(bossConfigs) do
        if cfg.key == key then
            return cfg
        end
    end
    return nil
end

local playAutoClicked = false

local function isGuiActuallyVisible(obj, stopAt)
    local cur = obj
    while cur and cur ~= stopAt do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        end
        cur = cur.Parent
    end
    return true
end

local function cleanLabelText(text)
    return (tostring(text or ""):gsub("<[^>]*>", ""):gsub("^%s+", ""):gsub("%s+$", ""):lower())
end

local function getLoadingGuiState()
    local loadingGui = playerGui:FindFirstChild("LoadingGUI")
    if not loadingGui then
        return nil, nil, false
    end
    if loadingGui:IsA("ScreenGui") and not loadingGui.Enabled then
        return loadingGui, nil, false
    end

    local hasLoadingBar = false
    for _, obj in ipairs(loadingGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible and obj.TextTransparency < 0.9 and isGuiActuallyVisible(obj, loadingGui) then
            local lower = cleanLabelText(obj.Text)
            if lower:find("loading data", 1, true) or (lower:find("loading", 1, true) and lower:find("%", 1, true)) then
                hasLoadingBar = true
                break
            end
        end
    end

    local playBtn = loadingGui:FindFirstChild("Play") or loadingGui:FindFirstChild("Play", true)
    if playBtn and playBtn:IsA("GuiButton") and playBtn.Visible and isGuiActuallyVisible(playBtn, loadingGui) then
        local sz = playBtn.AbsoluteSize
        if sz.X > 0 and sz.Y > 0 then
            return loadingGui, playBtn, hasLoadingBar
        end
    end

    return loadingGui, nil, hasLoadingBar
end

local function clickPlayButton(btn)
    local fired = false
    if type(firesignal) == "function" then
        if type(getconnections) == "function" then
            local ok1, c1 = pcall(getconnections, btn.MouseButton1Click)
            if ok1 and type(c1) == "table" and #c1 > 0 then
                fired = pcall(firesignal, btn.MouseButton1Click)
            end
            if not fired then
                local ok2, c2 = pcall(getconnections, btn.Activated)
                if ok2 and type(c2) == "table" and #c2 > 0 then
                    fired = pcall(firesignal, btn.Activated)
                end
            end
        end
        if not fired then
            fired = pcall(firesignal, btn.MouseButton1Click)
        end
    end

    if not fired then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local pos = btn.AbsolutePosition
            local size = btn.AbsoluteSize
            local inset = GuiService:GetGuiInset()
            local x = pos.X + size.X * 0.5
            local y = pos.Y + size.Y * 0.5 + inset.Y
            vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.03)
            vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end
end

local function tryClickPlayOnce()
    if playAutoClicked then return false end
    local _, btn, hasLoadingBar = getLoadingGuiState()
    if not btn or not btn.Parent or hasLoadingBar then
        return false
    end

    playAutoClicked = true
    clickPlayButton(btn)
    return true
end

local function isLoadingGuiActive()
    local loadingGui, playBtn, hasLoadingBar = getLoadingGuiState()
    if loadingGui and (not loadingGui:IsA("ScreenGui") or loadingGui.Enabled) then
        if playBtn or hasLoadingBar then
            return true
        end
    end
    return false
end

local function isOnLoadingOrPlayScreen()
    if isLoadingGuiActive() then
        return true
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return true
    end

    return false
end

local function hookLoadingGui(gui)
    if not gui or gui.Name ~= "LoadingGUI" then return end
    gui.DescendantAdded:Connect(function(desc)
        if not playAutoClicked and desc.Name == "Play" then
            task.defer(tryClickPlayOnce)
        end
    end)
    local playObj = gui:FindFirstChild("Play") or gui:FindFirstChild("Play", true)
    if playObj then
        playObj:GetPropertyChangedSignal("Visible"):Connect(function()
            if not playAutoClicked then
                task.defer(tryClickPlayOnce)
            end
        end)
    end
    task.defer(tryClickPlayOnce)
end

hookLoadingGui(playerGui:FindFirstChild("LoadingGUI"))
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "LoadingGUI" then
        hookLoadingGui(child)
    end
end)

task.spawn(function()
    local deadline = os.clock() + 60
    while not playAutoClicked and screen.Parent and os.clock() < deadline do
        if tryClickPlayOnce() then
            break
        end
        if not isOnLoadingOrPlayScreen() then
            break
        end
        task.wait(0.06)
    end
end)

local function cancelAutoHopMode(prefix, showStatus)
    dkHopGeneration = dkHopGeneration + 1
    if finding then
        stopFinding(showStatus and (prefix .. " выключен") or nil, MUTED)
    elseif showStatus then
        setStatus(prefix .. " выключен", MUTED)
    end
end

cancelAutoHopDk = function(showStatus)
    cancelAutoHopMode("auto hop dk", showStatus)
end

cancelAutoHopCrab = function(showStatus)
    cancelAutoHopMode("auto hop crab", showStatus)
end

local function triggerAutoHopBoss(opts)
    dkHopGeneration = dkHopGeneration + 1
    local myGen = dkHopGeneration

    local function isActive()
        return settings[opts.settingKey] == true and dkHopGeneration == myGen and screen.Parent
    end

    task.spawn(function()
        if #publicServers == 0 or (os.clock() - lastPublicFetchAt) > 5 then
            fetchServers()
        end
    end)

    task.spawn(function()
        local bossCfg = findBossConfigByKey(opts.bossKey)

        if not game:IsLoaded() and not isLoadingGuiActive() then
            setStatus(opts.prefix .. ": жду загрузку игры...", ACCENT)
            while isActive() and not game:IsLoaded() and not isLoadingGuiActive() do
                if bossCfg then
                    bossCfg.locNode = nil
                    bossCfg.lastBossScan = 0
                    bossCfg.lastTimerScan = 0
                    updateBossConfig(bossCfg, os.clock())
                    if bossCfg.stateKind == "alive"
                        or (bossCfg.stateKind == "timer" and bossCfg.timerSeconds ~= nil) then
                        break
                    end
                end
                task.wait(0.04)
            end
        end
        if not isActive() then return end

        if isLoadingGuiActive() then
            setStatus(opts.prefix .. ": жду загрузку / PLAY...", ACCENT)
            while isActive() and isLoadingGuiActive() do
                if not playAutoClicked then
                    tryClickPlayOnce()
                end
                task.wait(0.04)
            end
            if not isActive() then return end
        end

        bossCfg = bossCfg or findBossConfigByKey(opts.bossKey)
        if not bossCfg then
            opts.setFn(false, true)
            setStatus("ошибка: конфиг " .. opts.shortName .. " не найден", DANGER)
            return
        end

        setStatus(opts.prefix .. ": проверяю " .. opts.fullName .. "...", ACCENT)

        for i = 1, 35 do
            if not isActive() then return end
            bossCfg.locNode = nil
            bossCfg.lastBossScan = 0
            bossCfg.lastTimerScan = 0
            updateBossConfig(bossCfg, os.clock())
            if bossCfg.stateKind == "alive"
                or (bossCfg.stateKind == "timer" and bossCfg.timerSeconds ~= nil) then
                break
            end
            if i < 35 then
                task.wait(0.04)
            end
        end

        if not isActive() then return end

        if bossCfg.stateKind == "alive" then
            opts.setFn(false, true)
            updateAllBosses()
            setStatus(opts.shortName .. " жив! auto hop остановлен", SUCCESS)
            return
        end

        if bossCfg.stateKind == "timer" and bossCfg.timerSeconds and bossCfg.timerSeconds <= DK_HOP_THRESHOLD_SEC then
            opts.setFn(false, true)
            updateAllBosses()
            setStatus(opts.shortName .. ": " .. (bossCfg.timerText or ""), SUCCESS)
            return
        end

        if bossCfg.stateKind == "unknown"
            and not workspace:FindFirstChild("Areas")
            and not workspace:FindFirstChild("Island") then
            opts.setFn(false, true)
            setStatus(opts.shortName .. " не найден (нужен 3 мир)", DANGER)
            return
        end

        if type(game.JobId) == "string" and game.JobId ~= "" then
            markVisited(game.JobId)
            saveVisited()
        end

        local msg = bossCfg.timerText
            and string.format("%s: %s (>30м) — телепорт...", opts.shortName, bossCfg.timerText)
            or (opts.shortName .. ": жду спавн — телепорт...")
        setStatus(msg, ACCENT)

        if #publicServers == 0 then
            while fetchingServers and #publicServers == 0 and isActive() do
                task.wait(0.04)
            end
        end
        if not isActive() then return end

        if #publicServers == 0 or (os.clock() - lastPublicFetchAt) > 10 then
            if not fetchingServers then
                if not fetchServers() and #servers == 0 then
                    setStatus(opts.prefix .. ": нет списка серверов", DANGER)
                    return
                end
            end
        end

        if not isActive() then return end
        finding = true
        attemptTeleport(0)
    end)
end

