local function collectUiMetadata()
    local browser = findServerBrowser()
    local main = browser and browser:FindFirstChild("MainFrame")
    if not main then return end

    local updated = false
    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Name == "IdLabel" then
            local row = obj.Parent
            local code = (obj.Text or ""):match("#?%s*(%d+)")
            if row and code and code ~= "0000" then
                if type(row.GetAttributes) == "function" then
                    for attrName, attrVal in pairs(row:GetAttributes()) do
                        if type(attrVal) == "string" and attrVal ~= "" then
                            local aname = tostring(attrName):lower()
                            if aname:find("region", 1, true) or aname:find("country", 1, true) or aname:find("loc", 1, true) then
                                serverRegionsByCode[code] = regionCodeMap[attrVal:lower()] or attrVal
                                updated = true
                            end
                        end
                    end
                end
                for _, child in ipairs(row:GetDescendants()) do
                    if child:IsA("TextLabel") and child ~= obj and child.Name ~= "NameLabel" then
                        local cname = child.Name:lower()
                        local txt = (child.Text or ""):gsub("<[^>]*>", ""):gsub("^%s+", ""):gsub("%s+$", "")
                        if txt ~= "" then
                            local curStr, maxStr = txt:match("(%d+)%s*/%s*(%d+)")
                            if curStr and maxStr then
                                serverUiCountsByCode[code] = {
                                    players = tonumber(curStr),
                                    maxPlayers = tonumber(maxStr),
                                }
                                updated = true
                            elseif cname:find("region", 1, true) or cname:find("country", 1, true) or cname:find("loc", 1, true) then
                                serverRegionsByCode[code] = regionCodeMap[txt:lower()] or txt
                                updated = true
                            else
                                local matchedReg = looksLikeRegionText(txt)
                                if matchedReg then
                                    serverRegionsByCode[code] = matchedReg
                                    updated = true
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if updated then
        for _, entry in ipairs(servers) do
            if entry.code then
                if not entry.region and serverRegionsByCode[entry.code] then
                    entry.region = serverRegionsByCode[entry.code]
                end
                local uiCount = serverUiCountsByCode[entry.code]
                if uiCount and not entry.fromPublicApi then
                    entry.players = uiCount.players
                    entry.maxPlayers = uiCount.maxPlayers
                end
            end
        end
        table.sort(servers, compareServers)
    end
end

local fetchingServers = false

local function fetchServers()
    if fetchingServers then return false end
    fetchingServers = true

    local before = serverGeneration
    local remoteDone = false

    task.spawn(function()
        local nativeOk, nativeButton = pcall(findNativeRefreshButton)
        if nativeOk and nativeButton and type(firesignal) == "function" then
            pcall(firesignal, nativeButton.MouseButton1Click)
        else
            pcall(function()
                getServers:InvokeServer()
            end)
        end
        remoteDone = true
    end)

    local gotPublic = fetchRobloxPublicServers(5)
    for waitIdx = 1, 2 do
        if gotPublic then break end
        task.wait(0.7 * waitIdx)
        gotPublic = fetchRobloxPublicServers(5)
    end

    if serverGeneration == before then
        task.spawn(function()
            if remoteDone then
                pcall(function()
                    getServers:InvokeServer()
                end)
            end
        end)
        task.wait(0.06)
    end

    pcall(collectUiMetadata)

    local success = gotPublic or (serverGeneration > before) or (#servers > 0)
    fetchingServers = false
    return success
end

local function scanBestServer()
    local best
    local current = normalizeId(game.JobId)
    local candidates = 0
    local skippedVisited = 0
    local hasVisitedSmall = false

    for _, server in ipairs(servers) do
        local key = normalizeId(server.id)
        if key and key ~= current
            and not server.restricted
            and server.players and server.players > 0
            and server.maxPlayers and server.players < server.maxPlayers
            and (server.maxPlayers < 6 or server.players < server.maxPlayers - 1) then
            candidates = candidates + 1
            if visited[key] or failedServers[key] then
                skippedVisited = skippedVisited + 1
                if visited[key] and not failedServers[key] and server.players <= 4 then
                    hasVisitedSmall = true
                end
            elseif not best or compareServers(server, best) then
                best = server
            end
        end
    end

    return best, candidates, skippedVisited, hasVisitedSmall
end

local function chooseServer(allowTrim)
    if pruneVisited() then
        saveVisited()
    end

    local picked, candidates, skippedVisited, hasVisitedSmall = scanBestServer()
    if allowTrim and hasVisitedSmall and (not picked or (picked.players or 999) > 4) then
        if trimOldestVisited(6) then
            saveVisited()
            picked, candidates, skippedVisited = scanBestServer()
        end
    end
    return picked, candidates, skippedVisited
end

