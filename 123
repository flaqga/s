local fpsSavedTerrain = nil
local fpsSavedObjects = setmetatable({}, {__mode = "k"})

local protectedModelKeywords = {
    "npc", "boss", "enemy", "monster", "dragon", "kraken", "tentacle",
    "serpent", "crab", "tyrant", "jack", "depth", "hydra", "seaking",
    "pirate", "marine", "vendor", "shop", "quest", "eldritch",
}

local function isProtectedTracker(obj)
    local cur = obj
    while cur and cur ~= workspace do
        local cname = cur.Name
        if cname == "Areas" or cname == "SerpentWhirlpool" then
            return true
        end
        if cur ~= obj and (cur:IsA("BillboardGui") or cur:IsA("SurfaceGui")) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function isProtectedModel(obj)
    local cur = obj
    while cur and cur ~= workspace do
        if cur:IsA("Model") then
            if Players:GetPlayerFromCharacter(cur)
                or cur:FindFirstChildOfClass("Humanoid")
                or cur:FindFirstChildOfClass("AnimationController") then
                return true
            end
        end
        local lower = cur.Name:lower()
        for _, kw in ipairs(protectedModelKeywords) do
            if lower:find(kw, 1, true) then
                return true
            end
        end
        cur = cur.Parent
    end
    return false
end

local function optimizeFpsObject(obj)
    if not obj or not obj.Parent or isProtectedTracker(obj) then return end

    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
        or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        if not fpsSavedObjects[obj] then
            fpsSavedObjects[obj] = {kind = "fx", enabled = obj.Enabled}
        end
        obj.Enabled = false
        return
    end

    if obj:IsA("Highlight") then
        if isProtectedModel(obj) then return end
        if not fpsSavedObjects[obj] then
            fpsSavedObjects[obj] = {kind = "fx", enabled = obj.Enabled}
        end
        obj.Enabled = false
        return
    end

    if obj:IsA("BillboardGui") then
        if isProtectedModel(obj) then return end
        if not fpsSavedObjects[obj] then
            fpsSavedObjects[obj] = {kind = "fx", enabled = obj.Enabled}
        end
        obj.Enabled = false
        return
    end

    if isProtectedModel(obj) then return end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        if not fpsSavedObjects[obj] then
            fpsSavedObjects[obj] = {kind = "tex", transparency = obj.Transparency}
        end
        obj.Transparency = 1
    elseif obj:IsA("BasePart") then
        if not fpsSavedObjects[obj] then
            fpsSavedObjects[obj] = {
                kind = "part",
                material = obj.Material,
                shadow = obj.CastShadow,
                reflectance = obj.Reflectance,
            }
        end
        obj.CastShadow = false
        obj.Reflectance = 0
        obj.Material = Enum.Material.SmoothPlastic
    end
end

local function optimizeLightingEffect(eff)
    if eff:IsA("BloomEffect") or eff:IsA("SunRaysEffect") or eff:IsA("BlurEffect")
        or eff:IsA("DepthOfFieldEffect") or eff:IsA("ColorCorrectionEffect") then
        if not fpsSavedObjects[eff] then
            fpsSavedObjects[eff] = {kind = "fx", enabled = eff.Enabled}
        end
        eff.Enabled = false
    elseif eff:IsA("Atmosphere") then
        if not fpsSavedObjects[eff] then
            fpsSavedObjects[eff] = {kind = "atmo", density = eff.Density}
        end
        eff.Density = 0
    elseif eff:IsA("Clouds") then
        if not fpsSavedObjects[eff] then
            fpsSavedObjects[eff] = {kind = "clouds", cover = eff.Cover}
        end
        eff.Cover = 0
    elseif eff:IsA("Sky") then
        if not fpsSavedObjects[eff] then
            fpsSavedObjects[eff] = {
                kind = "sky",
                celestial = eff.CelestialBodiesShown,
                stars = eff.StarCount,
            }
        end
        eff.CelestialBodiesShown = false
        eff.StarCount = 0
    end
end

local function applyFpsBoost()
    fpsGeneration = fpsGeneration + 1
    local myGen = fpsGeneration

    if not fpsSavedLighting then
        fpsSavedLighting = {
            shadows = Lighting.GlobalShadows,
            diffuse = Lighting.EnvironmentDiffuseScale,
            specular = Lighting.EnvironmentSpecularScale,
        }
    end
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    for _, eff in ipairs(Lighting:GetChildren()) do
        optimizeLightingEffect(eff)
    end
    local cam = workspace.CurrentCamera
    if cam then
        for _, eff in ipairs(cam:GetChildren()) do
            optimizeLightingEffect(eff)
        end
    end

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        if not fpsSavedTerrain then
            local savedDeco
            pcall(function() savedDeco = terrain.Decoration end)
            fpsSavedTerrain = {
                waveSize = terrain.WaterWaveSize,
                waveSpeed = terrain.WaterWaveSpeed,
                reflectance = terrain.WaterReflectance,
                decoration = savedDeco,
            }
        end
        pcall(function()
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.Decoration = false
        end)
    end

    if fpsDescConn then
        fpsDescConn:Disconnect()
        fpsDescConn = nil
    end
    fpsDescConn = workspace.DescendantAdded:Connect(function(desc)
        if settings.fpsBoost and fpsGeneration == myGen then
            optimizeFpsObject(desc)
        end
    end)

    task.spawn(function()
        local list = workspace:GetDescendants()
        for i, obj in ipairs(list) do
            if not settings.fpsBoost or fpsGeneration ~= myGen or not screen.Parent then
                return
            end
            optimizeFpsObject(obj)
            if i % 300 == 0 then
                task.wait()
            end
        end
    end)
end

local function restoreFpsBoost()
    fpsGeneration = fpsGeneration + 1
    if fpsDescConn then
        fpsDescConn:Disconnect()
        fpsDescConn = nil
    end

    if fpsSavedLighting then
        pcall(function()
            Lighting.GlobalShadows = fpsSavedLighting.shadows
            Lighting.EnvironmentDiffuseScale = fpsSavedLighting.diffuse
            Lighting.EnvironmentSpecularScale = fpsSavedLighting.specular
        end)
        fpsSavedLighting = nil
    end

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain and fpsSavedTerrain then
        pcall(function()
            terrain.WaterWaveSize = fpsSavedTerrain.waveSize
            terrain.WaterWaveSpeed = fpsSavedTerrain.waveSpeed
            terrain.WaterReflectance = fpsSavedTerrain.reflectance
            if fpsSavedTerrain.decoration ~= nil then
                terrain.Decoration = fpsSavedTerrain.decoration
            end
        end)
        fpsSavedTerrain = nil
    end

    for obj, state in pairs(fpsSavedObjects) do
        if obj and obj.Parent then
            pcall(function()
                if state.kind == "fx" then
                    obj.Enabled = state.enabled
                elseif state.kind == "tex" then
                    obj.Transparency = state.transparency
                elseif state.kind == "part" then
                    obj.Material = state.material
                    obj.CastShadow = state.shadow
                    if state.reflectance ~= nil then
                        obj.Reflectance = state.reflectance
                    end
                elseif state.kind == "atmo" then
                    obj.Density = state.density
                elseif state.kind == "clouds" then
                    obj.Cover = state.cover
                elseif state.kind == "sky" then
                    obj.CelestialBodiesShown = state.celestial
                    obj.StarCount = state.stars
                end
            end)
        end
    end
    fpsSavedObjects = setmetatable({}, {__mode = "k"})
end

