local function normalizeId(id)
    if type(id) ~= "string" and type(id) ~= "number" then return nil end
    local text = tostring(id):gsub("^%s+", ""):gsub("%s+$", ""):lower()
    text = text:gsub("^{", ""):gsub("}$", "")
    if text == "" then return nil end
    return text
end

local VISITED_TTL_SEC = 2700
local visited = {}
local failedServers = {}

local function markVisited(id, ts)
    local key = normalizeId(id)
    if key then
        visited[key] = (type(ts) == "number" and ts > 1000) and ts or os.time()
    end
    return key
end

local function pruneVisited()
    local now = os.time()
    local removed = false
    for id, ts in pairs(visited) do
        if type(ts) == "number" and (now - ts) > VISITED_TTL_SEC then
            visited[id] = nil
            removed = true
        end
    end
    return removed
end

local function trimOldestVisited(keepCount)
    local entries = {}
    local currentKey = normalizeId(game.JobId)
    for id, ts in pairs(visited) do
        if id ~= currentKey then
            entries[#entries + 1] = {id = id, ts = (type(ts) == "number") and ts or 0}
        end
    end
    if #entries <= keepCount then return false end
    table.sort(entries, function(a, b)
        return a.ts > b.ts
    end)
    for i = keepCount + 1, #entries do
        visited[entries[i].id] = nil
    end
    return true
end

local function saveVisited()
    pruneVisited()
    local out = {}
    for id, ts in pairs(visited) do
        out[id] = (type(ts) == "number" and ts > 1000) and ts or os.time()
    end
    writeJson(visitedFile, out)
end

local function unmarkVisited(id)
    local key = normalizeId(id)
    if key then visited[key] = nil end
end

local function loadVisited()
    local data = readJson(visitedFile)
    if type(data) ~= "table" then return end
    for key, value in pairs(data) do
        if type(value) == "number" and value > 1000 then
            markVisited(key, value)
        elseif value == true or value == 1 then
            markVisited(key)
        end
    end
    for _, value in ipairs(data) do
        if type(value) == "string" then
            markVisited(value)
        end
    end
    pruneVisited()
end

local function visitedCount()
    local count = 0
    for _ in pairs(visited) do
        count = count + 1
    end
    return count
end

