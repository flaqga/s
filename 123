local function looksLikeRegionText(text)
    if type(text) ~= "string" then return nil end
    local trimmed = text:gsub("<[^>]*>", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if trimmed == "" or #trimmed > 48 then return nil end
    if trimmed:find("#", 1, true) or trimmed:match("^%d+%s*/%s*%d+$") then return nil end
    local lower = trimmed:lower()
    if regionCodeMap[lower] then
        return regionCodeMap[lower]
    end
    for _, kw in ipairs(regionKeywords) do
        if lower:find(kw, 1, true) then
            return trimmed
        end
    end
    return nil
end

local function readServerRegion(server)
    for _, field in ipairs(regionFields) do
        local value = server[field]
        if type(value) == "string" then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" then
                return regionCodeMap[text:lower()] or text
            end
        end
    end
    for field, value in pairs(server) do
        if type(value) == "string" and field ~= "JobId" and field ~= "Name" then
            local matched = looksLikeRegionText(value)
            if matched then return matched end
        elseif type(value) == "table" then
            for _, subField in ipairs(regionFields) do
                local subVal = value[subField]
                if type(subVal) == "string" then
                    local text = subVal:gsub("^%s+", ""):gsub("%s+$", "")
                    if text ~= "" then
                        return regionCodeMap[text:lower()] or text
                    end
                end
            end
        end
    end
    return nil
end

local function readServerName(server)
    for _, field in ipairs(nameFields) do
        local value = server[field]
        if type(value) == "string" then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" and text ~= "Server Name" and not text:find("(Your Server)", 1, true) then
                return text, field
            end
        end
    end

    for field, value in pairs(server) do
        if type(value) == "string" and value:find("#%s*%d+") then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" then return text, tostring(field) end
        end
    end
    return nil
end

local function isRestrictedServer(server)
    if server.Private == true
        or server.IsPrivate == true
        or server.Reserved == true
        or server.Locked == true
        or server.IsReserved == true then
        return true
    end
    if type(server.AccessCode) == "string" and server.AccessCode ~= "" then
        return true
    end
    if type(server.ServerType) == "string" and server.ServerType:lower():find("private", 1, true) then
        return true
    end
    return false
end

