local function attemptTeleport(retryCount)
    if not finding then return end
    currentRetryCount = retryCount

    local target, candidates, skippedVisited = chooseServer(true)
    if (not target or (target.players or 999) >= 5)
        and (#publicServers == 0 or (os.clock() - lastPublicFetchAt) > 15) then
        local thisWaitAttempt = teleportAttemptId
        local maxWaits = (settings.autoHopDk or settings.autoHopCrab) and 6 or 3
        for waitTry = 1, maxWaits do
            if not finding or teleportAttemptId ~= thisWaitAttempt then return end
            setStatus(string.format("лимит API — ищу маленькие (%d/%d)...", waitTry, maxWaits), ACCENT)
            task.wait(1.5)
            if not finding or teleportAttemptId ~= thisWaitAttempt then return end
            if fetchRobloxPublicServers(5) then
                target, candidates, skippedVisited = chooseServer(true)
                if target and (target.players or 999) < 5 then
                    break
                end
            end
        end
    end

    if target and (target.players or 999) >= 6 and #publicServers == 0 then
        stopFinding("API лимит — не захожу на полный сервер", DANGER)
        return
    end

    if not target then
        if retryCount > 0 then
            stopFinding("подходящие серверы закончились", DANGER)
        elseif candidates > 0 and skippedVisited == candidates then
            stopFinding("все подходящие серверы уже посещены", MUTED)
        else
            stopFinding("нет подходящих серверов", DANGER)
        end
        return
    end

    pendingTargetKey = normalizeId(target.id)
    if pendingTargetKey then
        markVisited(pendingTargetKey)
        saveVisited()
    end

    local needLoader = settings.autoExecute or ((settings.autoHopDk or settings.autoHopCrab) and settings.loader ~= "")
    local queueFn = getQueueFunction()
    if needLoader and not queueFn then
        if pendingTargetKey then
            unmarkVisited(pendingTargetKey)
            saveVisited()
        end
        stopFinding("executor не поддерживает авто-запуск", DANGER)
        return
    end

    if queueFn then
        local bootstrap, err = buildBootstrap(needLoader)
        if not bootstrap then
            if pendingTargetKey then
                unmarkVisited(pendingTargetKey)
                saveVisited()
            end
            stopFinding(err, DANGER)
            return
        end

        local ok, queueErr = pcall(queueFn, bootstrap)
        if not ok and needLoader then
            if pendingTargetKey then
                unmarkVisited(pendingTargetKey)
                saveVisited()
            end
            stopFinding("ошибка очереди: " .. tostring(queueErr), DANGER)
            return
        end
    end

    teleportAttemptId = teleportAttemptId + 1
    local thisAttempt = teleportAttemptId

    findButton.Text = "отмена"
    if target.region and target.region ~= "" then
        setStatus(string.format("телепорт: %s (%d/%d)", target.region, target.players, target.maxPlayers), ACCENT)
    else
        setStatus(string.format("телепорт: %d/%d", target.players, target.maxPlayers), ACCENT)
    end

    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(target.placeId, target.id, player)
    end)

    if not ok then
        if pendingTargetKey then
            failedServers[pendingTargetKey] = true
            pendingTargetKey = nil
        end
        if retryCount < MAX_TELEPORT_RETRIES then
            setStatus("ошибка запуска — ищу другой...", ACCENT)
            task.wait(0.15)
            if finding and teleportAttemptId == thisAttempt then
                attemptTeleport(retryCount + 1)
            end
        else
            stopFinding("не удалось начать телепорт", DANGER)
        end
        return
    end

    task.delay(15, function()
        if finding and teleportAttemptId == thisAttempt then
            stopFinding("таймаут телепорта — попробуй снова", DANGER)
        end
    end)
end

