    local h = heightOverride or math.max(frame.Size.Y.Offset, BASE_HEIGHT)
    local pos = frame.Position
    local px = pos.X.Scale * vpX + pos.X.Offset
    local py = pos.Y.Scale * vpY + pos.Y.Offset

    local minX = WIDTH * 0.5
    local maxX = math.max(minX, vpX - WIDTH * 0.5)
    local minY = 0
    local maxY = math.max(0, vpY - h)

    local cx = math.clamp(px, minX, maxX)
    local cy = math.clamp(py, minY, maxY)

    if math.abs(cx - px) > 0.5 or math.abs(cy - py) > 0.5 then
        clampingPos = true
        frame.Position = UDim2.fromOffset(math.floor(cx + 0.5), math.floor(cy + 0.5))
