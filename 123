    end

    if currentRetryCount < MAX_TELEPORT_RETRIES then
        local attemptAtFail = teleportAttemptId
        setStatus("сервер недоступен — ищу другой...", ACCENT)
        task.spawn(function()
            task.wait(0.15)
            if finding and teleportAttemptId == attemptAtFail then
