local function getDataPingMs()
    local ok, val = pcall(function()
        local net = Stats:FindFirstChild("Network")
        local items = net and net:FindFirstChild("ServerStatsItem")
        local dataPing = items and items:FindFirstChild("Data Ping")
        if dataPing then
            return dataPing:GetValue()
        end
        return nil
    end)
    if ok and type(val) == "number" and val == val then
        return math.max(0, math.floor(val + 0.5))
    end
    local ok2, ping = pcall(function()
        return player:GetNetworkPing() * 2000
    end)
    if ok2 and type(ping) == "number" and ping == ping then
        return math.max(0, math.floor(ping + 0.5))
    end
    return 0
end

