local function countTableEntries(tbl)
    if type(tbl) ~= "table" then return nil end
    local n = 0
    for _ in pairs(tbl) do
        n = n + 1
    end
    return n
end

local function readNumber(server, keys)
    for _, key in ipairs(keys) do
        local value = server[key]
        if type(value) == "number" then return value end
        if type(value) == "string" then
            local number = tonumber(value)
            if number then return number end
            local current = value:match("(%d+)%s*/%s*%d+")
            if current then return tonumber(current) end
        end
    end
end

local nameFields = {"Name", "ServerName", "DisplayName", "Code", "ServerCode", "ShortCode", "Title"}
local regionFields = {
    "Region", "region", "Country", "country", "CountryName", "countryName",
    "CountryCode", "countryCode", "Location", "location",
    "ServerRegion", "serverRegion", "Area", "area", "Zone", "zone",
}

local function readServerRegion(server)
    for _, field in ipairs(regionFields) do
        local value = server[field]
        if type(value) == "string" then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" then
                return text
            end
        end
    end
    return nil
end

local function readServerName(server)
    for _, field in ipairs(nameFields) do
        local value = server[field]
        if type(value) == "string" then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" and text ~= "Server Name" and not text:find("(Your Server)", 1, true) then
                return text, field
            end
        end
    end

    for field, value in pairs(server) do
        if type(value) == "string" and value:find("#%s*%d+") then
            local text = value:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" then return text, tostring(field) end
        end
    end
    return nil
end

local function isRestrictedServer(server)
    if server.Private == true
        or server.IsPrivate == true
        or server.Reserved == true
        or server.Locked == true
        or server.IsReserved == true then
        return true
    end
    if type(server.AccessCode) == "string" and server.AccessCode ~= "" then
        return true
    end
    if type(server.ServerType) == "string" and server.ServerType:lower():find("private", 1, true) then
        return true
    end
    return false
end

local serverUiCountsByCode = {}
local serverRegionsByCode = {}

local function rebuildServerList(remoteList)
    local byId = {}
    local merged = {}

    local function addEntry(entry, isPublicApi)
        local key = normalizeId(entry.id)
        if not key then return end

        local existing = byId[key]
        if not existing then
            local copy = {
                id = entry.id,
                name = entry.name,
                code = entry.code,
                region = entry.region,
                placeId = entry.placeId,
                players = entry.players,
                maxPlayers = entry.maxPlayers,
                restricted = entry.restricted,
                fromPublicApi = isPublicApi,
            }
            byId[key] = copy
            merged[#merged + 1] = copy
        else
            if entry.name and not existing.name then existing.name = entry.name end
            if entry.code and not existing.code then existing.code = entry.code end
            if entry.region and not existing.region then existing.region = entry.region end
            if isPublicApi then
                existing.players = entry.players
                existing.maxPlayers = entry.maxPlayers
                existing.fromPublicApi = true
            end
            if entry.restricted then existing.restricted = true end
        end
    end

    if type(remoteList) == "table" then
        for _, entry in ipairs(remoteList) do
            addEntry(entry, false)
        end
    end

    for _, entry in ipairs(publicServers) do
        addEntry(entry, true)
    end

    table.sort(merged, function(a, b)
        return (a.players or 999) < (b.players or 999)
    end)

    servers = merged
end

local function fetchRobloxPublicServers(maxPages)
    local pages = maxPages or 3
    local placeIdStr = tostring(game.PlaceId)
    local currentKey = normalizeId(game.JobId)
    local hosts = {
        "https://games.roblox.com",
        "https://games.roproxy.com",
        "https://games.roblox.com",
    }

    local collected = {}
    local fetchedAny = false

    for hostIdx, host in ipairs(hosts) do
        if hostIdx == 3 then
            task.wait(1.2)
        end
        local cursor = ""
        local hostOk = false
        local foundOpenCandidate = false
        for page = 1, pages do
            if page > 1 then
                task.wait(0.4)
            end
            local url = string.format(
                "%s/v1/games/%s/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true%s",
                host,
                placeIdStr,
                cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
            )
            local body, status = httpGetUrl(url)
            if not body and status == 429 then
                task.wait(1.0)
                body, status = httpGetUrl(url)
            end
            if not body then break end

            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
            if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
                break
            end

            hostOk = true
            fetchedAny = true

            for _, srv in ipairs(decoded.data) do
                if type(srv) == "table" and type(srv.id) == "string" and srv.id ~= "" then
                    local playing = tonumber(srv.playing) or 0
                    if type(srv.playerTokens) == "table" and #srv.playerTokens > playing then
                        playing = #srv.playerTokens
                    end
                    local maxP = tonumber(srv.maxPlayers) or defaultMaxPlayers
                    if playing > 0 and playing < maxP then
                        local key = normalizeId(srv.id)
                        if key and key ~= currentKey and not visited[key] and not failedServers[key] then
                            foundOpenCandidate = true
                        end
                        collected[#collected + 1] = {
                            id = srv.id,
                            placeId = game.PlaceId,
                            players = playing,
                            maxPlayers = maxP,
                            restricted = false,
                        }
                    end
                end
            end

            if foundOpenCandidate then
                break
            end

            local nextCursor = decoded.nextPageCursor
            if type(nextCursor) ~= "string" or nextCursor == "" then
                break
            end
            cursor = nextCursor
        end
        if hostOk then break end
    end

    if fetchedAny then
        table.sort(collected, function(a, b)
            return (a.players or 999) < (b.players or 999)
        end)
        publicServers = collected
        lastPublicFetchAt = os.clock()
        lastFetchAt = lastPublicFetchAt
        rebuildServerList(remoteServersCache)
    end
    return fetchedAny
end

local function applyServers(result)
    serverGeneration = serverGeneration + 1
    lastFetchAt = os.clock()
    local parsed = {}
    local foundCurrentName
    local currentKey = normalizeId(game.JobId)

    for key, server in pairs(result) do
        if type(server) == "table" then
            local rawId = server.JobId
            if type(rawId) ~= "string" or rawId == "" then
                rawId = server.JobID or server.jobId or server.ServerId or server.ServerID
                    or server.Id or server.id or key
            end
            local id = tostring(rawId or "")
            local count = readNumber(server, {"PlayerCount", "Playing", "Players", "CurrentPlayers", "NumPlayers", "playerCount", "playing", "Count"})
            if not count and type(server.Players) == "table" then
                count = countTableEntries(server.Players)
            end
            local maxPlayers = readNumber(server, {"MaxPlayers", "Capacity", "Max", "maxPlayers", "capacity"}) or defaultMaxPlayers
            if type(server.Players) == "string" then
                local cStr, mStr = server.Players:match("(%d+)%s*/%s*(%d+)")
                if cStr and mStr then
                    count = tonumber(cStr)
                    maxPlayers = tonumber(mStr)
                end
            end

            local name = readServerName(server)
            local code = name and name:match("#%s*(%d+)")
            local uiCount = code and serverUiCountsByCode[code]
            if uiCount then
                count = uiCount.players
                maxPlayers = uiCount.maxPlayers
            end

            if id ~= "" and count and count > 0 and count < maxPlayers then
                local region = readServerRegion(server)
                local normalized = normalizeId(id)
                if normalized and normalized == currentKey and name then
                    foundCurrentName = name
                end
                if not region and code then
                    region = serverRegionsByCode[code]
                end
                if normalized and code then
                    serverCodes[normalized] = code
                end
                parsed[#parsed + 1] = {
                    id = id,
                    name = name,
                    code = code,
                    region = region,
                    placeId = tonumber(server.PlaceId) or game.PlaceId,
                    players = count,
                    maxPlayers = maxPlayers,
                    restricted = isRestrictedServer(server),
                }
            end
        end
    end

    remoteServersCache = parsed
    rebuildServerList(parsed)

    if foundCurrentName then
        currentServerName = foundCurrentName
    end

    if setStatus then
        local fresh = 0
        for _, entry in ipairs(servers) do
            local key = normalizeId(entry.id)
            if key and key ~= currentKey and not entry.restricted
                and entry.players > 0 and entry.players < entry.maxPlayers
                and not visited[key] and not failedServers[key] then
                fresh = fresh + 1
            end
        end
        setStatus(string.format("серверов: %d · новых: %d", #servers, fresh), MUTED)
    end
end

