        end)
    else
        stopFinding("телепорт не удался: " .. tostring(message), DANGER)
    end
end)

local DK_HOP_THRESHOLD_SEC = 1800
local dkHopGeneration = 0

local function findDepthKingConfig()
    for _, cfg in ipairs(bossConfigs) do
        if cfg.key == "depthking" then
            return cfg
        end
    end
    return nil
end

local playAutoClicked = false

local function isGuiActuallyVisible(obj, stopAt)
    local cur = obj
    while cur and cur ~= stopAt do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        end
        cur = cur.Parent
    end
    return true
end

local function cleanLabelText(text)
    return (tostring(text or ""):gsub("<[^>]*>", ""):gsub("^%s+", ""):gsub("%s+$", ""):lower())
end

local function findPlayButton()
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui ~= screen then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("GuiButton") and obj.Visible and obj.Active and isGuiActuallyVisible(obj, gui) then
                    if obj:IsA("TextButton") and cleanLabelText(obj.Text) == "play" then
                        return obj
                    end
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("TextLabel") and child.Visible and cleanLabelText(child.Text) == "play" then
                            return obj
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function tryClickPlayOnce()
    if playAutoClicked then return false end
    local btn = findPlayButton()
    if not btn or not btn.Parent then return false end

    playAutoClicked = true
    task.wait(0.25)
    if not btn.Parent then return true end

    local fired = false
    if type(firesignal) == "function" then
        if type(getconnections) == "function" then
            local ok1, c1 = pcall(getconnections, btn.MouseButton1Click)
            if ok1 and type(c1) == "table" and #c1 > 0 then
                fired = pcall(firesignal, btn.MouseButton1Click)
            else
                local ok2, c2 = pcall(getconnections, btn.Activated)
                if ok2 and type(c2) == "table" and #c2 > 0 then
                    fired = pcall(firesignal, btn.Activated)
                end
            end
        end
        if not fired then
            fired = pcall(firesignal, btn.MouseButton1Click)
        end
    end

    if not fired then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local pos = btn.AbsolutePosition
            local size = btn.AbsoluteSize
            local inset = GuiService:GetGuiInset()
            local x = pos.X + size.X * 0.5
            local y = pos.Y + size.Y * 0.5 + inset.Y
            vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.05)
            vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end

    return true
end

local function isOnLoadingOrPlayScreen()
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui ~= screen then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("GuiButton") and obj.Visible and isGuiActuallyVisible(obj, gui) then
                    if obj:IsA("TextButton") and cleanLabelText(obj.Text) == "play" then
                        return true
                    end
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("TextLabel") and child.Visible and cleanLabelText(child.Text) == "play" then
                            return true
                        end
                    end
                elseif obj:IsA("TextLabel") and obj.Visible and isGuiActuallyVisible(obj, gui) then
                    if cleanLabelText(obj.Text):find("loading data", 1, true) then
                        return true
                    end
                end
            end
        end
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return true
    end

    return false
end

task.spawn(function()
    local deadline = os.clock() + 60
    while not playAutoClicked and screen.Parent and os.clock() < deadline do
        if tryClickPlayOnce() then
            break
        end
        if not isOnLoadingOrPlayScreen() then
            break
        end
        task.wait(0.4)
    end
end)

cancelAutoHopDk = function(showStatus)
    dkHopGeneration = dkHopGeneration + 1
    if finding then
        stopFinding(showStatus and "auto hop dk выключен" or nil, MUTED)
    elseif showStatus then
        setStatus("auto hop dk выключен", MUTED)
    end
end

triggerAutoHopDk = function()
    dkHopGeneration = dkHopGeneration + 1
    local myGen = dkHopGeneration

    task.spawn(function()
        if not game:IsLoaded() then
            setStatus("auto hop dk: жду загрузку игры...", ACCENT)
            repeat task.wait(0.3) until game:IsLoaded() or not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent
        end
        if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end

        if isOnLoadingOrPlayScreen() then
            setStatus("auto hop dk: жду загрузку / PLAY...", ACCENT)
            while settings.autoHopDk and dkHopGeneration == myGen and screen.Parent and isOnLoadingOrPlayScreen() do
                if not playAutoClicked then
                    tryClickPlayOnce()
                end
                task.wait(0.5)
            end
            if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end
            task.wait(2.5)
        end

        if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end

        local dkCfg = findDepthKingConfig()
        if not dkCfg then
            setAutoHopDk(false, true)
            setStatus("ошибка: конфиг DK не найден", DANGER)
            return
        end

        setStatus("auto hop dk: проверяю Depth King...", ACCENT)

        for i = 1, 16 do
            if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end
            dkCfg.lastBossScan = 0
            dkCfg.lastTimerScan = 0
            updateBossConfig(dkCfg, os.clock())
            if dkCfg.stateKind ~= "unknown" then
                break
            end
            if i < 16 then
                task.wait(0.5)
            end
        end

        if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end

        if dkCfg.stateKind == "alive" then
            setAutoHopDk(false, true)
            updateAllBosses()
            setStatus("DK жив! auto hop остановлен", SUCCESS)
            return
        end

        if dkCfg.stateKind == "timer" and dkCfg.timerSeconds and dkCfg.timerSeconds <= DK_HOP_THRESHOLD_SEC then
            setAutoHopDk(false, true)
            updateAllBosses()
            setStatus(string.format("DK: %s (<=30м) — стоп!", dkCfg.timerText or ""), SUCCESS)
            return
        end

        if dkCfg.stateKind == "unknown"
            and not workspace:FindFirstChild("Areas")
            and not workspace:FindFirstChild("Island") then
            setAutoHopDk(false, true)
            setStatus("DK не найден (нужен 3 мир)", DANGER)
            return
        end

        if type(game.JobId) == "string" and game.JobId ~= "" then
            markVisited(game.JobId)
            saveVisited()
        end

        local msg = dkCfg.timerText
            and string.format("DK: %s (>30м) — ищу сервер...", dkCfg.timerText)
            or "DK: жду спавн — ищу сервер..."
        setStatus(msg, ACCENT)

        if #publicServers == 0 or (os.clock() - lastPublicFetchAt) > 8 then
            if not fetchRobloxPublicServers(3) and #servers == 0 then
                if not fetchServers() and #servers == 0 then
                    setStatus("auto hop dk: нет списка серверов", DANGER)
                    return
                end
            end
        end

        if not settings.autoHopDk or dkHopGeneration ~= myGen or not screen.Parent then return end
        finding = true
        attemptTeleport(0)
    end)
end

if settings.autoHopDk then
    triggerAutoHopDk()
end
