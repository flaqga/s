    end

    local before = serverGeneration
    local nativeOk, nativeButton = pcall(findNativeRefreshButton)

    if nativeOk and nativeButton and type(firesignal) == "function" then
        task.spawn(function()
            pcall(firesignal, nativeButton.MouseButton1Click)
        end)
        for _ = 1, 5 do
            task.wait(0.2)
            if serverGeneration > before then
                success = true
                break
            end
        end
    end

    if serverGeneration == before and not success then
        task.spawn(function()
            pcall(function()
                getServers:InvokeServer()
            end)
        end)
        for _ = 1, 8 do
            task.wait(0.2)
            if serverGeneration > before then
                success = true
                break
            end
        end
    end

    pcall(collectUiMetadata)

    fetchingServers = false
    return success
end

local function chooseServer()
    local best
    local current = normalizeId(game.JobId)
    local candidates = 0
    local skippedVisited = 0

    for _, server in ipairs(servers) do
        local key = normalizeId(server.id)
        if key and key ~= current
            and not server.restricted
            and server.players and server.players > 0
            and server.maxPlayers and server.players < server.maxPlayers then
            candidates = candidates + 1
            if visited[key] or failedServers[key] then
                skippedVisited = skippedVisited + 1
            elseif not best or server.players < best.players then
                best = server
            end
        end
    end

    return best, candidates, skippedVisited
end

